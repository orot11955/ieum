{
  "name": "@ieum/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./identity-service": {
      "types": "./dist/identity-service.d.ts",
      "default": "./dist/identity-service.js"
    },
    "./command-coordinator": {
      "types": "./dist/command-coordinator.d.ts",
      "default": "./dist/command-coordinator.js"
    },
    "./preferences": {
      "types": "./dist/preferences.d.ts",
      "default": "./dist/preferences.js"
    },
    "./captures": {
      "types": "./dist/captures.d.ts",
      "default": "./dist/captures.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "default": "./dist/knowledge.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./calendar-time": {
      "types": "./dist/calendar-time.d.ts",
      "default": "./dist/calendar-time.js"
    },
    "./platform/database/scope": {
      "types": "./dist/platform/database/scope.d.ts",
      "default": "./dist/platform/database/scope.js"
    },
    "./platform/database/schema": {
      "types": "./dist/platform/database/schema.d.ts",
      "default": "./dist/platform/database/schema.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./system": {
      "types": "./dist/system.d.ts",
      "default": "./dist/system.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "vitest run test/*.integration.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
