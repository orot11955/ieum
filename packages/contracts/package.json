{
  "name": "@ieum/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./management": {
      "types": "./dist/management.d.ts",
      "default": "./dist/management.js"
    },
    "./management-client": {
      "types": "./generated/management.ts"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "default": "./dist/knowledge.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./judgement": {
      "types": "./dist/judgement.d.ts",
      "default": "./dist/judgement.js"
    },
    "./extraction": {
      "types": "./dist/extraction.d.ts",
      "default": "./dist/extraction.js"
    },
    "./delivery": {
      "types": "./dist/delivery.d.ts",
      "default": "./dist/delivery.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "default": "./dist/documents.js"
    },
    "./workbench": {
      "types": "./dist/workbench.d.ts",
      "default": "./dist/workbench.js"
    },
    "./generation": {
      "types": "./dist/generation.d.ts",
      "default": "./dist/generation.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./publishing": {
      "types": "./dist/publishing.d.ts",
      "default": "./dist/publishing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ieum/core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "openapi-fetch": "0.17.0"
  }
