{
  "name": "@ieum/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./management": {
      "types": "./dist/management.d.ts",
      "default": "./dist/management.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "default": "./dist/knowledge.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./delivery": {
      "types": "./dist/delivery.d.ts",
      "default": "./dist/delivery.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
