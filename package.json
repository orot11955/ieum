{
  "name": "ieum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "design:build": "node scripts/design/build.mjs",
    "design:check": "node scripts/design/check.mjs",
    "design:test": "node --test scripts/design/test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run design:build && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@tanstack/react-query": "^5.90.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.5",
    "jsdom": "^27.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  }
}
