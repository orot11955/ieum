{
  "name": "ieum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "design:build": "node scripts/design/build.mjs && node scripts/design/themes.mjs",
    "design:check": "node scripts/design/check.mjs && node scripts/design/themes.mjs --check",
    "design:test": "node --test scripts/design/test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run design:build && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.4",
    "@tanstack/react-query": "5.103.2",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
