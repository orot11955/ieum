# Node 24. Copy to .env; never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://127.0.0.1:5173
# PGlite is local development only. Production must use PostgreSQL + a non-owner role.
DATABASE_URL=pglite:.data/local-db
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ASSET_DIR=.data/assets
REQUIRE_MFA=true
DELIVERY_PUBLIC=false
# MIGRATION_DATABASE_URL=postgres://migration_admin:...@127.0.0.1:5432/ieum
